{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "\\.pnpm/(@nestjs\\+bullmq|@nestjs\\+schedule|@nestjs\\+bull-shared|@nestjs\\+config|@apidevtools\\+json-schema-ref-parser)@.+\\.m?js$": "<rootDir>/babel-transformer.cjs"
  },
  "transformIgnorePatterns": [
    "\\.pnpm/(?!(@nestjs\\+bullmq|@nestjs\\+schedule|@nestjs\\+bull-shared|@nestjs\\+config|@apidevtools\\+json-schema-ref-parser)@)"
  ],
  "testTimeout": 30000,
  "forceExit": true
}
