# Copy to apps/api/.env (ConfigModule's envFilePath: [".env"] resolves relative to this
# package's own working directory, not the repo root). Values below match docker-compose.yml's
# defaults — fine for local dev, never for production.

# --- Database ---
# Matches docker-compose.yml's postgres service.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulse

# The API's own runtime role — unprivileged, created by the RLS migration (ADR-003). Never the
# same role as DB_MIGRATION_USER below: RLS is bypassed for table owners and superusers, so
# connecting the app with migration credentials would make every RLS policy a silent no-op.
DB_USER=pulse_app
DB_PASSWORD=pulse_app_dev_password

# The Postgres superuser that owns the tables — used only by `pnpm migration:up`, never by the
# running API. Matches docker-compose.yml's POSTGRES_USER/POSTGRES_PASSWORD.
DB_MIGRATION_USER=pulse
DB_MIGRATION_PASSWORD=pulse_dev_password

# --- Auth ---
# Sign the access token with a real secret in every environment but local dev.
JWT_ACCESS_SECRET=dev-only-insecure-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_MS=2592000000
INVITATION_TTL_MS=604800000

# The first Platform Owner account, seeded on boot if none exists yet (PulseOwnerSeeder). Unset
# in an environment that already has one — the seeder no-ops once a Platform Owner exists.
PLATFORM_OWNER_EMAIL=owner@pulse.test
PLATFORM_OWNER_PASSWORD=change-me-before-first-boot

# --- Server ---
PORT=3001
CORS_ORIGIN=http://localhost:3000
